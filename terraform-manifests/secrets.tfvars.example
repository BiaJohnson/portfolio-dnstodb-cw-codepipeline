# Copy to secrets.tfvars (gitignored) for local apply, OR let CodeBuild generate it.
# terraform apply -var-file=dev.tfvars -var-file=secrets.tfvars
#
# Use TWO different strong passwords.
# After first apply, create MySQL user `app3` (and refresh App3 ASG):
#   ./ops/phase-a-create-app3-user.sh
# app3_db_password must match Parameter Store /<env>/app3/db/password after apply.
#
# --- CodePipeline / CodeBuild ---
# Create these SecureString parameters once (console or CLI) before the first run.
# Do NOT store AWS access keys here — Terraform authenticates as the CodeBuild role.
#
#   /CodeBuild/DB_PASSWORD        → db_password
#   /CodeBuild/APP3_DB_PASSWORD   → app3_db_password
#
#   aws ssm put-parameter --name /CodeBuild/DB_PASSWORD --type SecureString \
#     --value 'YOUR_RDS_MASTER_PASSWORD'
#   aws ssm put-parameter --name /CodeBuild/APP3_DB_PASSWORD --type SecureString \
#     --value 'YOUR_APP3_USER_PASSWORD'
#
# CodeBuild env.parameter-store injects those as DB_PASSWORD / APP3_DB_PASSWORD,
# then ops/write-secrets-tfvars.sh writes this gitignored file. Attach ssm:GetParameters
# (and bootstrap SendCommand/ASG describe) to both CodeBuild service roles.

# RDS master (ops only — never used by the App3 WAR)
db_password = "REPLACE_WITH_MASTER_PASSWORD"

# App3 least-privilege user password (SSM SecureString + CREATE USER)
app3_db_password = "REPLACE_WITH_STRONG_UNIQUE_APP3_PASSWORD"
